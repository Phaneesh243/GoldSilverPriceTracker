# Attributed metal references enabled by default (terms reviewed 2026-09-08).
# Set false to disable. This never enables local retail or historical scraping.
METALS_REFERENCE_FEED_ENABLED=true
# Optional legacy override: explicit false also disables current references.
METALS_REFERENCE_RIGHTS_CONFIRMED=true
# Legacy scraper remains disabled; this is NOT sufficient to enable city pages.
METALS_LEGACY_RETAIL_RIGHTS_CONFIRMED=false
# Ads require a real approved publisher/account, slot map and reviewed CMP bridge.
# NEXT_PUBLIC values are public and fixed at build time.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOTS={}
NEXT_PUBLIC_DISABLE_EXTERNAL_ADS=true
